{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "geo-news-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "geo-news-bot",
      "database_id": "83c22a56-379b-4f3f-8e01-d0136fb3a4aa",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    "AI_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
    "MAX_ITEMS_PER_RUN": "6",
    "MAX_AGE_HOURS": "48",
    "MIN_URGENCY": "4"
  }
}
